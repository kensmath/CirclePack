<?xml version="1.0"?>
<CP_Scriptfile date="Sep 22, 2026">
<CPscript title="OrthoPack trials" >
<text> OrthoPack is aimed at euclidean packings whose bdry circles are orthogonal to the unit circle.. I am desining an algorithm to iteratively move a packing towards an orthogonal packing. </text>
<cmd iconname="klines.png">Cleanse;act 0;infile_read rand250.p;disp -w -c; </cmd>
<cmd iconname="button_ok.png">extender -r op;|op| tscale;|op| error;set_screen -a;Disp -w -c -e b -uc5 </cmd>
<cmd iconname="mozilla.png">|op| ortho; </cmd>
<cmd inline="no" name="r" mnemonic="r" iconname="dnd_multi.png">|op| run 200;|op| error;disp -wr </cmd>
<cmd iconname="dnd_multi.png">|op| run 10;|op| error;disp -wr </cmd>
<cmd inline="no" name="a" mnemonic="a" iconname="debugger.png">|op| ref_adj;|op| run 10;|op| error;disp -wr </cmd>
<cmd inline="no" name="w" mnemonic="w" iconname="centrejust.png">|op| ref_adj vlist;|op| error;disp -wr </cmd>
<cmd inline="no" name="c" mnemonic="c" iconname="centrejust.png">set_vlist z #XY;|op| r_adj vlist;rld; </cmd>
  </CPscript>
